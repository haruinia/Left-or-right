{
  "author": "haruinia",
  "name": "shuihuo-killer-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "左右：在题目旁边，找到另一种思路。半透明截图学习助手。",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "start:win": "node main/windows-runtime.js start",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "node main/windows-runtime.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.shuihuo.killer.cockpit",
    "productName": "左右",
    "files": [
      "main/**",
      "preload/**",
      "config.example.json",
      "assets/**"
    ],
    "beforePack": "main/build-backend.js",
    "extraResources": [
      {
        "from": "../web",
        "to": "web"
      },
      {
        "from": "native",
        "to": "native"
      },
      {
        "from": "backend/left-or-right-gateway",
        "to": "backend"
      }
    ],
    "artifactName": "Left-or-right-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "实时转写面试对话需要麦克风权限。",
        "NSScreenCaptureUsageDescription": "笔试截图出题需要屏幕录制权限。"
      },
      "icon": "assets/icon.icns"
    }
  }
}
